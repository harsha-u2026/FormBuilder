# Frontend Environment Configuration Template

# Backend API base URL
# Leave empty for production same-origin deployment (API requests will use relative /api/v1)
# In development, set to http://localhost:8000 (or rely on Vite dev proxy)
VITE_API_URL=

# Public survey URL override (optional)
# By default, copied survey share links use window.location.origin
# Set this if respondents should access forms via a dedicated domain
# VITE_PUBLIC_URL=https://surveys.example.com
